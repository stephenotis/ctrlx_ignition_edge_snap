{
    "$schema": "https://json-schema.boschrexroth.com/ctrlx-automation/ctrlx-core/apps/package-manifest/package-manifest.v1.3.schema.json",
    "version": "1.0.0",
    "id": "ctrlx-ignition-edge",
    "menus": {
      "sidebar": [
        {
          "id": "ctrl-ignition-edge",
          "title": "Ignition Edge",
          "icon": "bosch-ic-molecule-gas",
          "items": [
            {
              "id": "ctrlx-ignition-edge-gateway",
              "title": "Gateway",
              "target": "ctrlx-ignition-gateway",
              "link": "http://${hostname}:9088/",
              "items": []
            },
            {
              "id": "ctrlx-ignition-edge-vision",
              "title": "Vision Client Launch",
              "target": "_blank",
              "link": "http://${hostname}:9088/app/home/vision/client-launcher",
              "items": []
            }
          ]         
        }
      ]
    },
    "configuration": {
      "appDirectories": [
        {
        "name": "ignition",
        "description": "Ignition Edge gateway configuration",
        "icon": "bosch-ic-components",
        "copyOnLoad": true,
        "writeProtected": false
        }
      ]
   }
}
